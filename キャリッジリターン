スクリプト

cr.sh

#!/bin/bash

# 対象ディレクトリ（指定がなければカレントディレクトリ）
TARGET_DIR="${1:-.}"

echo "Searching for files with Carriage Return (CR) in: ${TARGET_DIR}"

# \r を含むテキストファイルを検索して一括変換（sed -i）
find "${TARGET_DIR}" -type f -exec grep -Iq $'\r' {} \; -print | while read -r file; do
    echo "Cleaning: ${file}"
    sed -i 's/\r$//' "${file}"
done

echo "Done!"


