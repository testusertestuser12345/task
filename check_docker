構成

docker-test/
├── cert.pem          # 証明書（自動生成）
├── key.pem           # 秘密鍵（自動生成）
├── nginx.conf        # NGINX設定
└── docker-compose.yml


証明書
openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=test-server"


nginx.confの設定
  
events {
    worker_connections 1024;
}

http {
    server {
        listen 443 ssl;
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        location /api/v1/health {
            default_type text/plain;
            return 200 'STATUS_HEALTHY_OK';
        }

        location /auth/session {
            default_type text/plain;
            return 200 'AUTH_TOKEN_VALID';
        }

        location /system/info {
            default_type text/plain;
            return 200 'NODE_READY';
        }
    }
}


docker-compose.yml

version: '3.8'

services:
  edge-node-alpha:
    image: nginx:alpine
    container_name: edge-node-alpha
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./cert.pem:/etc/nginx/ssl/cert.pem:ro
      - ./key.pem:/etc/nginx/ssl/key.pem:ro
    networks:
      custom_wide_net:
        ipv4_address: 172.28.10.12

  edge-node-beta:
    image: nginx:alpine
    container_name: edge-node-beta
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./cert.pem:/etc/nginx/ssl/cert.pem:ro
      - ./key.pem:/etc/nginx/ssl/key.pem:ro
    networks:
      custom_wide_net:
        ipv4_address: 172.28.50.88

  edge-node-gamma:
    image: nginx:alpine
    container_name: edge-node-gamma
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./cert.pem:/etc/nginx/ssl/cert.pem:ro
      - ./key.pem:/etc/nginx/ssl/key.pem:ro
    networks:
      custom_wide_net:
        ipv4_address: 172.28.210.201

networks:
  custom_wide_net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16



