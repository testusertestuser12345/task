import http.server
import ssl
import threading

class MockHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        port = self.server.server_port

        # 443/text -> hello_world
        if port == 443 and self.path == "/text":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"hello_world")

        # 8443/test -> hello_test (text.com経由含む)
        elif port == 8443 and self.path == "/test":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"hello_test")

        # 443 のドキュメントルート -> document
        elif port == 443 and self.path == "/":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"document")

        else:
            self.send_response(404)
            self.end_headers()
            self.wfile.write(b"Not Found")

    def log_message(self, format, *args):
        pass

def start_http(port):
    server = http.server.HTTPServer(('0.0.0.0', port), MockHandler)
    server.serve_forever()

def start_https(port):
    server = http.server.HTTPServer(('0.0.0.0', port), MockHandler)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(certfile="cert.pem", keyfile="key.pem")
    server.socket = ctx.wrap_socket(server.socket, server_side=True)
    server.serve_forever()

if __name__ == "__main__":
    print("Mock Server Started (HTTP: 80 | HTTPS: 443, 8443)")
    threading.Thread(target=start_http, args=(80,), daemon=True).start()
    threading.Thread(target=start_https, args=(443,), daemon=True).start()
    threading.Thread(target=start_https, args=(8443,), daemon=True).start()
    threading.Event().wait()








