【System/390 (s390x)】

mkdir -p ~/qemu-s390x && cd ~/qemu-s390x

# ダウンロード（latest-stable に修正）
wget -O vmlinuz-lts https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/s390x/netboot/vmlinuz-lts
wget -O initramfs-lts https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/s390x/netboot/initramfs-lts

# QEMU 起動 (※s390x のみ virtio-net-ccw を使用)
qemu-system-s390x -M s390-ccw-virtio -m 512m \
  -kernel vmlinuz-lts -initrd initramfs-lts -nographic \
  -append "console=ttysclp0 ip=192.168.4.50::192.168.4.1:255.255.255.0" \
  -netdev tap,id=net0,ifname=tap3,script=no,downscript=no \
  -device virtio-net-ccw,netdev=net0

