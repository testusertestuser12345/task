【PowerPC (ppc64le)】

mkdir -p ~/qemu-ppc64 && cd ~/qemu-ppc64

# ダウンロード（latest-stable に修正）
wget -O vmlinuz-lts https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/ppc64le/netboot/vmlinuz-lts
wget -O initramfs-lts https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/ppc64le/netboot/initramfs-lts

# QEMU 起動
qemu-system-ppc64 -M pseries -m 512m \
  -kernel vmlinuz-lts -initrd initramfs-lts -nographic \
  -append "console=hvc0 ip=192.168.3.50::192.168.3.1:255.255.255.0" \
  -netdev tap,id=net0,ifname=tap2,script=no,downscript=no \
  -device virtio-net-pci,netdev=net0

