【ARM64 (AArch64)】

mkdir -p ~/qemu-arm64 && cd ~/qemu-arm64

# ダウンロード（-q を外して確実に進捗確認）
wget -O vmlinuz-lts https://dl-cdn.alpinelinux.org/alpine/v3.19/releases/aarch64/netboot/vmlinuz-lts
wget -O initramfs-lts https://dl-cdn.alpinelinux.org/alpine/v3.19/releases/aarch64/netboot/initramfs-lts

# QEMU 起動 (新構文: netdev + device)
qemu-system-aarch64 -M virt -cpu cortex-a57 -m 512m \
  -kernel vmlinuz-lts -initrd initramfs-lts -nographic \
  -append "console=ttyAMA0 ip=192.168.1.50::192.168.1.1:255.255.255.0" \
  -netdev tap,id=net0,ifname=tap0,script=no,downscript=no \
  -device virtio-net-pci,netdev=net0

